{
  "name": "learning-gazette",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent weekly newsletter pipeline with an n8n-style live dashboard, built for the Harvard AI in Education club.",
  "scripts": {
    "dev": "concurrently -n server,dashboard -c blue,magenta \"npm run dev:server\" \"npm run dev:dashboard\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:dashboard": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "start": "npm run build && tsx src/server/index.ts",
    "generate": "tsx src/core/cli.ts generate",
    "render": "tsx src/core/cli.ts render",
    "demo": "tsx src/core/cli.ts generate --mock --auto-publish",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate-issue": "tsx src/core/cli.ts validate"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@xyflow/react": "^12.11.6",
    "dotenv": "^17.2.0",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
