# Copy to .env and fill in. Never commit .env.

# Which model provider runs the agents: claude-code | api | mock
#   claude-code  headless Claude Code sessions using the claude.ai login on this machine
#                (covered by a Claude subscription; run `claude` once to log in)
#   api          the Anthropic API with the key below (pay-per-token)
# Leave unset to pick claude-code when logged in, else api when a key is set.
PROVIDER=

# Anthropic API key, only needed for PROVIDER=api or for the GitHub Action.
ANTHROPIC_API_KEY=

# Server port for the dashboard API (default 8787)
PORT=8787

# Weekly schedule (cron syntax, server-local timezone). Default: Friday 06:00.
# Set SCHEDULE_ENABLED=true to have the running dashboard server generate on schedule.
SCHEDULE_ENABLED=false
SCHEDULE_CRON=0 6 * * 5
SCHEDULE_TZ=America/New_York

# When true, runs started from the dashboard publish without a human approval step.
AUTO_PUBLISH=false

# Max desks running concurrently (rate-limit friendly). Default 3.
MAX_CONCURRENCY=3
